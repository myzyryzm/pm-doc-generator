# Model for every headless Claude Code session (alias or pinned id).
PMDOC_MODEL=opus

# Turn budgets. A story trace reads widely; a mapping pass inventories one repo.
PMDOC_MAX_TURNS=400
PMDOC_MAP_MAX_TURNS=200

# Reasoning effort for trace and mapping sessions (low, medium, high, xhigh, max).
PMDOC_EFFORT=xhigh

# Model for the quick prompt → action resolution call (no repo tools, one turn).
PMDOC_RESOLVE_MODEL=sonnet

# The folder that holds the project's repos (it never lives in this repo).
# Relative repo paths in projects/<name>.yaml resolve against it. Override it
# for a single run with: PROJECT_FOLDER=/path/to/app python cli.py ...
PROJECT_FOLDER=~/myproject
